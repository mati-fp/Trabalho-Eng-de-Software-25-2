# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_NAME=cipcei_db

# JWT Authentication
# Gere secrets seguros (um para cada) usando: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Os dois precisam ser diferentes entre si e NUNCA devem ser commitados com valores reais.
JWT_SECRET=troque-por-um-secret-forte-gerado-com-o-comando-acima
JWT_REFRESH_SECRET=troque-por-outro-secret-forte-diferente-do-anterior
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration (separar múltiplas origens com vírgula)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# TypeORM
# ATENÇÃO: NUNCA use synchronize=true em produção!
TYPEORM_SYNCHRONIZE=true

# Email Configuration
# Para desenvolvimento, pode usar Mailtrap (https://mailtrap.io) ou similar
MAIL_ENABLED=false
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_SECURE=false
MAIL_USER=seu_usuario_mailtrap
MAIL_PASSWORD=sua_senha_mailtrap
MAIL_FROM=noreply@cipcei.ufrgs.br